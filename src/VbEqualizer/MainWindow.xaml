<Window x:Class="VbEqualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:audio="clr-namespace:VbEqualizer.Audio"
        mc:Ignorable="d"
        Title="マイクイコライザ (ASIO)" Height="800" Width="880" MinHeight="560" MinWidth="740">
    <Window.Resources>
        <DataTemplate DataType="{x:Type audio:EqualizerBand}">
            <StackPanel Orientation="Vertical" Width="60" Margin="4,0" HorizontalAlignment="Center">
                <TextBlock Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}"
                           HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,2"/>
                <TextBox Text="{Binding FrequencyText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Width="54" FontSize="11"
                         HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                         KeyDown="FrequencyTextBox_KeyDown"
                         ToolTip="中心周波数 (例: 500, 0.5k, 1k)。グラフ上のノードをドラッグしても調整できます。"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type audio:ChannelSettings}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" Content="EQ適用" VerticalAlignment="Center" Margin="0,0,12,0"
                          IsChecked="{Binding EqEnabled, Mode=TwoWay}"/>
                <Slider Grid.Column="2" Minimum="0" Maximum="150" VerticalAlignment="Center"
                        Value="{Binding VolumePercent, Mode=TwoWay}"/>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="6,0"
                           Text="{Binding VolumePercent, StringFormat={}{0:0}%}"/>
                <ToggleButton Grid.Column="4" Content="ミュート" Padding="8,2"
                              IsChecked="{Binding IsMuted, Mode=TwoWay}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="設定を保存(_S)..." Click="SaveSettingsMenuItem_Click"/>
                <MenuItem Header="設定を読み込む(_O)..." Click="LoadSettingsMenuItem_Click"/>
                <MenuItem Header="起動時にこの設定を読み込む(_T)" Click="SetStartupSettingsMenuItem_Click"/>
                <Separator/>
                <MenuItem x:Name="SettingsPathMenuItem" Header="設定ファイル: (未設定)" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="AutoStartEngineMenuItem" Header="起動時に自動的に処理を開始する"
                          IsCheckable="True"/>
                <MenuItem x:Name="RunAtWindowsStartupMenuItem" Header="Windowsログオン時に自動起動"
                          IsCheckable="True" Checked="RunAtWindowsStartupMenuItem_Changed"
                          Unchecked="RunAtWindowsStartupMenuItem_Changed"/>
                <MenuItem x:Name="StartMinimizedToTrayMenuItem" Header="起動時はトレイに格納する"
                          IsCheckable="True"/>
            </MenuItem>
        </Menu>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Device selection -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="入力 ASIOドライバ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="InputDriverCombo" Width="180" Margin="0,0,16,0"
                          SelectionChanged="InputDriverCombo_SelectionChanged"/>
                <TextBlock x:Name="InputSampleRateText" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="出力 ASIOドライバ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="OutputDriverCombo" Width="180" Margin="0,0,16,0"
                          SelectionChanged="OutputDriverCombo_SelectionChanged"/>
                <TextBlock x:Name="OutputSampleRateText" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="デバイス再読込" Click="RefreshButton_Click" Padding="8,3" Margin="0,0,8,0"/>
                <Button x:Name="StartStopButton" Content="開始" Click="StartStopButton_Click" Padding="18,3" FontWeight="Bold" Margin="0,0,16,0"/>
                <TextBlock x:Name="ChannelCountText" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Per-channel settings -->
        <Border Grid.Row="1" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Background="#0A000000">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="チャンネル別設定" FontWeight="Bold" FontSize="12" Margin="2,0,0,6"/>
                <ItemsControl x:Name="ChannelSettingsItemsControl"/>
            </StackPanel>
        </Border>

        <!-- EQ curve + per-band frequency entry -->
        <Border Grid.Row="2" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="10" Background="#0A000000">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="イコライザー" FontWeight="Bold" FontSize="12" Margin="2,0,0,6"/>
                <Border x:Name="EqCurveHost" Height="240" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,8"/>
                <ItemsControl x:Name="BandsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- High-pass / noise gate -->
        <Border Grid.Row="3" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Background="#0A000000">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="フィルター / ゲート" FontWeight="Bold" FontSize="12" Margin="2,0,0,6"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="HighPassCheckBox" Content="ハイパス" VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="HighPassCheckBox_Changed" Unchecked="HighPassCheckBox_Changed"/>
                    <Slider x:Name="HighPassSlider" Width="140" Minimum="20" Maximum="300" Value="100"
                            ValueChanged="HighPassSlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HighPassLabel" Text="100 Hz" Width="56" VerticalAlignment="Center" Margin="6,0,24,0"/>

                    <CheckBox x:Name="NoiseGateCheckBox" Content="ノイズゲート" VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="NoiseGateCheckBox_Changed" Unchecked="NoiseGateCheckBox_Changed"/>
                    <Slider x:Name="NoiseGateSlider" Width="140" Minimum="-80" Maximum="-20" Value="-50"
                            ValueChanged="NoiseGateSlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NoiseGateLabel" Text="-50 dB" Width="56" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Expander -->
        <Border Grid.Row="4" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Background="#0A000000">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="エキスパンダー" FontWeight="Bold" FontSize="12" Margin="2,0,0,6"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ExpanderCheckBox" Content="有効" VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="ExpanderCheckBox_Changed" Unchecked="ExpanderCheckBox_Changed"/>
                    <TextBlock Text="しきい値" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="ExpanderThresholdSlider" Width="120" Minimum="-80" Maximum="-10" Value="-40"
                            ValueChanged="ExpanderThresholdSlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ExpanderThresholdLabel" Text="-40 dB" Width="56" VerticalAlignment="Center" Margin="6,0,24,0"/>

                    <TextBlock Text="比率" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="ExpanderRatioSlider" Width="100" Minimum="1" Maximum="10" Value="2" TickFrequency="1"
                            ValueChanged="ExpanderRatioSlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ExpanderRatioLabel" Text="2:1" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Noise suppression -->
        <Border Grid.Row="5" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Background="#0A000000">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="ノイズ抑制" FontWeight="Bold" FontSize="12" Margin="2,0,0,6"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="NoiseSuppressionCheckBox" Content="有効" VerticalAlignment="Center" Margin="0,0,10,0"
                              Checked="NoiseSuppressionCheckBox_Changed" Unchecked="NoiseSuppressionCheckBox_Changed"/>
                    <TextBlock Text="エンジン:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="NoiseSuppressionEngineCombo" Width="190" VerticalAlignment="Center" Margin="0,0,16,0"
                              SelectionChanged="NoiseSuppressionEngineCombo_SelectionChanged"/>
                    <TextBlock Text="強さ" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="NoiseSuppressionSlider" Width="140" Minimum="-60" Maximum="0" Value="-20"
                            ValueChanged="NoiseSuppressionSlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NoiseSuppressionLabel" Text="-20 dB" Width="56" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="NoiseSuppressionHintText" FontSize="11" Foreground="#888" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="6" Margin="0,10,0,0" Text="停止中" Foreground="#666" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
