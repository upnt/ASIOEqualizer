<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="マイクイコライザ"
           Manufacturer="マイクイコライザ"
           Version="1.0.0"
           UpgradeCode="1D58BF08-C762-4BAB-BB8A-112226773E4F"
           Language="1041"
           Codepage="65001"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="より新しいバージョンが既にインストールされています。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="..\src\VbEqualizer\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="マイクイコライザ" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="マイクイコライザ" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="マイクイコライザ" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExeComponent" Guid="9BCD37BD-C6D1-4D64-8225-7FCA4C1E0327">
        <File Id="VbEqualizerExe"
              Source="..\src\VbEqualizer\bin\publish\win-x64\VbEqualizer.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcutComponent" Directory="AppProgramMenuFolder"
               Guid="BC6F1481-FAED-49BE-93E1-B536BA07FB57">
      <Shortcut Id="StartMenuShortcut"
                Name="マイクイコライザ"
                Description="ASIO対応マイク用イコライザー・ノイズ抑制"
                Target="[INSTALLFOLDER]VbEqualizer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\VbEqualizer" Name="StartMenuShortcutInstalled"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder"
               Guid="750FE27C-E1B7-43BA-970B-A3D207390FC5">
      <Shortcut Id="DesktopShortcut"
                Name="マイクイコライザ"
                Description="ASIO対応マイク用イコライザー・ノイズ抑制"
                Target="[INSTALLFOLDER]VbEqualizer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\VbEqualizer" Name="DesktopShortcutInstalled"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
